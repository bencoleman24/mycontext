# Directory where your personal data is stored (profile.json, habits.json, etc.)
# Defaults to ~/.mycontext if unset.
MYCONTEXT_DATA_DIR=

# Port for the local web UI (npm run web). Defaults to 4823.
MYCONTEXT_WEB_PORT=

# Optional: used only when generating journal summaries locally via Ollama
# (the "Generate summary" / "Backfill summaries" actions). Defaults shown below.
MYCONTEXT_OLLAMA_BASE_URL=http://localhost:11434
MYCONTEXT_OLLAMA_MODEL=llama3.2
